# Copy this file to .env and fill in the values

# SQLite for local development (default)
MIRFAQ_DB_URL="file:./dev.db"

# To migrate to PostgreSQL later, change to:
# MIRFAQ_DB_URL="postgresql://USER:PASSWORD@HOST:5432/mirfaq"

# Required: Generate a strong random secret for session cookies
# Example: openssl rand -hex 32
SESSION_SECRET=change-this-to-a-strong-random-secret-in-production

# Comma-separated browser origins allowed to call the API.
APP_ORIGINS=http://localhost:5173

# API Server port (managed by workflow in Replit)
# PORT=5000

# ─── الإشعارات ───
# POST كل إشعار خارجي إلى هذا الرابط (n8n / Make / بوابة واتساب / Slack).
# اتركه فارغًا في التطوير ليُكتفى بتسجيل الإشعار في اللوق.
# NOTIFY_WEBHOOK_URL=

# اضبطه على 1 لتسجيل الإشعارات الصادرة في اللوق حتى في الإنتاج.
# NOTIFY_LOG=1

# اضبطه على 1 لتعطيل جدولة تذكيرات الصيانة الوقائية (يُستخدم في الاختبارات).
# DISABLE_PLAN_REMINDERS=1

# ─── تخزين المرفقات ───
# local (افتراضي) = قرص الخادم | s3 = حاوية متوافقة مع S3
# STORAGE_PROVIDER=s3
# S3_BUCKET=mirfaq-attachments
# S3_REGION=me-south-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# اضبط S3_ENDPOINT لمزوّد غير AWS (Cloudflare R2 أو MinIO أو Backblaze B2).
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_PREFIX=attachments
# S3_FORCE_PATH_STYLE=1
