// Prisma schema for مِرفق — property maintenance management (Phase 3)
// Uses SQLite for development demo.
//
// To migrate to PostgreSQL:
//   1. Change provider to "postgresql"
//   2. Change MIRFAQ_DB_URL to a postgres connection string
//   3. Run: prisma migrate deploy
//
// To migrate file storage to S3: see src/lib/storage.ts

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("MIRFAQ_DB_URL")
}

// ─── Multi-tenancy root ────────────────────────────────────────────────────────
model Organization {
  id         String   @id @default(cuid())
  name       String
  crNumber   String? // رقم السجل التجاري
  phone      String?
  city       String   @default("الرياض")
  brandColor String   @default("#0891b2")
  logoUrl    String?

  // ─── الاشتراك ───
  planCode            String    @default("tajribi") // tajribi | asasi | ihtirafi | munsha'at
  planStatus          String    @default("نشط") // نشط | موقوف | منتهٍ
  planRenewsAt        DateTime?
  planStartedAt       DateTime  @default(now())

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  users           User[]
  properties      Property[]
  requests        MaintenanceRequest[]
  attachments     RequestAttachment[]
  auditLogs       AuditLog[]
  leads           SalesLead[]
  preventivePlans PreventivePlan[]
  notifications   Notification[]
  invoices        Invoice[]
}

model User {
  id             String   @id @default(cuid())
  name           String
  email          String   @unique
  phone          String?
  passwordHash   String
  role           String // "manager" | "resident" | "technician"
  isActive       Boolean  @default(true)
  notifyInApp    Boolean  @default(true)
  notifyEmail    Boolean  @default(false)
  organizationId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization        Organization         @relation(fields: [organizationId], references: [id])
  managedProperties   Property[]           @relation("PropertyManager")
  residentUnit        Unit?                @relation("UnitResident")
  technicianProfile   TechnicianProfile?
  residentRequests    MaintenanceRequest[] @relation("RequestResident")
  comments            RequestComment[]
  uploadedAttachments RequestAttachment[]
  auditLogs           AuditLog[]           @relation("AuditActor")
  notifications       Notification[]
}

model Property {
  id             String   @id @default(cuid())
  name           String
  address        String
  managerId      String
  organizationId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization    Organization         @relation(fields: [organizationId], references: [id])
  manager         User                 @relation("PropertyManager", fields: [managerId], references: [id])
  units           Unit[]
  requests        MaintenanceRequest[]
  preventivePlans PreventivePlan[]
}

model Unit {
  id          String  @id @default(cuid())
  number      String
  floor       Int
  propertyId  String
  residentId  String? @unique
  publicToken String  @unique @default(cuid())

  property        Property             @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  resident        User?                @relation("UnitResident", fields: [residentId], references: [id])
  requests        MaintenanceRequest[]
  preventivePlans PreventivePlan[]
}

model TechnicianProfile {
  id        String  @id @default(cuid())
  userId    String  @unique
  specialty String
  phone     String?

  user            User                 @relation(fields: [userId], references: [id])
  requests        MaintenanceRequest[]
  preventivePlans PreventivePlan[]
}

model MaintenanceRequest {
  id               String    @id @default(cuid())
  title            String
  description      String
  category         String // كهرباء | سباكة | تكييف | أخرى
  priority         String // عاجل | عادي
  status           String // معلّقة | قيد التنفيذ | مكتملة
  propertyId       String
  unitId           String
  residentId       String
  technicianId     String?
  organizationId   String
  reporterName     String?
  reporterPhone    String?
  laborCostHalalas Int       @default(0)
  partsCostHalalas Int       @default(0)
  rating           Int?
  ratingComment    String?
  ratedAt          DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id])
  property     Property            @relation(fields: [propertyId], references: [id])
  unit         Unit                @relation(fields: [unitId], references: [id])
  resident     User                @relation("RequestResident", fields: [residentId], references: [id])
  technician   TechnicianProfile?  @relation(fields: [technicianId], references: [id])
  comments     RequestComment[]
  attachments  RequestAttachment[]
}

model PreventivePlan {
  id                   String    @id @default(cuid())
  organizationId       String
  propertyId           String
  unitId               String?
  assignedTechnicianId String?
  title                String
  category             String
  frequencyDays        Int
  nextDueAt            DateTime
  notes                String?
  isActive             Boolean   @default(true)
  lastCompletedAt      DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  organization       Organization       @relation(fields: [organizationId], references: [id])
  property           Property           @relation(fields: [propertyId], references: [id])
  unit               Unit?              @relation(fields: [unitId], references: [id], onDelete: SetNull)
  assignedTechnician TechnicianProfile? @relation(fields: [assignedTechnicianId], references: [id], onDelete: SetNull)

  @@index([organizationId, nextDueAt])
  @@index([propertyId])
  @@index([unitId])
  @@index([assignedTechnicianId])
}

model RequestComment {
  id        String   @id @default(cuid())
  content   String
  requestId String
  authorId  String
  createdAt DateTime @default(now())

  request MaintenanceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  author  User               @relation(fields: [authorId], references: [id])
}

// ─── File attachments ─────────────────────────────────────────────────────────
// filePath stores just the filename (UUID-based); files live in <cwd>/uploads/
// To replace with S3: see src/lib/storage.ts
model RequestAttachment {
  id             String   @id @default(cuid())
  requestId      String
  uploaderUserId String
  organizationId String
  filePath       String // filename only, e.g. "uuid.jpg"
  fileName       String // original name shown to user
  mimeType       String
  sizeBytes      Int
  attachmentType String // "initial" | "completion"
  createdAt      DateTime @default(now())

  request      MaintenanceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  uploader     User               @relation(fields: [uploaderUserId], references: [id])
  organization Organization       @relation(fields: [organizationId], references: [id])
}

// ─── Audit log ────────────────────────────────────────────────────────────────
model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  actorId        String
  actorName      String
  action         String // e.g. "create_request", "assign_technician"
  entityType     String // "request" | "property" | "unit" | "user"
  entityId       String?
  entityLabel    String?
  details        String? // JSON string for extra context
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  actor        User         @relation("AuditActor", fields: [actorId], references: [id])
}

model SalesLead {
  id             String   @id @default(cuid())
  organizationId String?
  name           String
  companyName    String
  phone          String
  email          String?
  unitsCount     Int?
  message        String?
  status         String   @default("جديد")
  createdAt      DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([createdAt])
}

// ─── الإشعارات ────────────────────────────────────────────────────────────────
// In-app notifications. Outbound channels (email/webhook) are dispatched by
// src/lib/notify-channels.ts and never block the request that produced them.
model Notification {
  id             String    @id @default(cuid())
  organizationId String
  userId         String
  type           String // request_created | request_assigned | request_status_changed | request_commented | request_rated | plan_due
  title          String
  body           String
  entityType     String? // "request" | "plan"
  entityId       String?
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([organizationId, createdAt])
}

// ─── الفوترة ──────────────────────────────────────────────────────────────────
// Monthly invoice per organization: subscription fee + maintenance costs
// recorded on requests completed during the period.
model Invoice {
  id                    String    @id @default(cuid())
  organizationId        String
  periodStart           DateTime
  periodEnd             DateTime
  planCode              String
  subscriptionHalalas   Int       @default(0)
  maintenanceHalalas    Int       @default(0)
  vatHalalas            Int       @default(0)
  totalHalalas          Int       @default(0)
  requestsCount         Int       @default(0)
  status                String    @default("مسودة") // مسودة | صادرة | مدفوعة
  issuedAt              DateTime?
  paidAt                DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, periodStart])
  @@index([organizationId, periodStart])
}
