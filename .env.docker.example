# انسخه إلى .env قبل تشغيل docker compose.

# ─── إلزامي ───
# كلمة مرور قاعدة البيانات (اختر قيمة قوية).
POSTGRES_PASSWORD=change-me

# سر الجلسات: 32 حرفًا فأكثر. ولّده بـ: openssl rand -hex 32
SESSION_SECRET=change-me-to-at-least-32-random-characters

# نطاقات المتصفح المسموح لها، مفصولة بفواصل.
APP_ORIGINS=https://mirfaq.example.com

# ─── اختياري ───
# POSTGRES_USER=mirfaq
# POSTGRES_DB=mirfaq
# APP_PORT=5000

# قناة الإشعارات الخارجية (بريد/واتساب/Slack).
# NOTIFY_WEBHOOK_URL=

# تخزين المرفقات: local (افتراضي) أو s3.
# مطلوب s3 عند تشغيل أكثر من نسخة من التطبيق.
# STORAGE_PROVIDER=s3
# S3_BUCKET=
# S3_REGION=me-south-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=
# S3_PREFIX=attachments
